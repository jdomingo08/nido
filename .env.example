# Copy this file to .env.local and fill in real values for local dev.
# Production values live in Vercel project settings.

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=
# Voice agent (Realtime API). Defaults: model=gpt-realtime-2,
# voice=marin, reasoning_effort=high. Valid efforts: minimal|low|medium|high|xhigh.
VOICE_REALTIME_MODEL=
VOICE_REALTIME_VOICE=
VOICE_REALTIME_REASONING_EFFORT=

# ─── Upstash Redis (rate limiting) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Push notifications (VAPID) ─────────────────────────────
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@needle.app

# ─── Weather ────────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ─── Sentry (optional) ──────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Comma-separated emails granted admin access.
ADMIN_EMAILS=

# ─── Plaid (Phase 1: Finances) ──────────────────────────────
# Get keys from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_ENV=sandbox                      # sandbox | development | production
PLAID_PRODUCTS=transactions            # comma-separated; Phase 1 only needs transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=                     # e.g. https://needle.app/api/finances/webhook (Phase 2)

# 32-byte base64 key for encrypting Plaid access tokens at rest.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FINANCES_ENCRYPTION_KEY=
